# Prefer `npm run android:signing:init` for the first release. For manual setup,
# copy this file to release/credentials/keystore.properties. That directory is
# intentionally gitignored and survives clean Expo prebuilds. Never commit the
# populated file or the keystore.
storeFile=../release/credentials/saient-upload.jks
storePassword=replace-with-secret
keyAlias=saient-upload
keyPassword=replace-with-secret
